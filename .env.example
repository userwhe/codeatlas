# Copy to .env and fill in. Never commit .env.

# Runtime mode: development, test, or production.
CODEATLAS_ENV=development
# 1 uses fixture repositories and fake model providers (development and test only).
CODEATLAS_FAKE_EXTERNALS=0

DATABASE_URL=postgresql+psycopg://codeatlas:codeatlas@localhost:5432/codeatlas
APP_ORIGIN=http://localhost:3000

# GitHub App (see specs/001-repository-qa/quickstart.md)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Path to the App's private key file, stored outside the repository.
GITHUB_APP_PRIVATE_KEY_PATH=
# Webhook secret set in the App's settings (see specs/002-push-reindexing/quickstart.md).
GITHUB_WEBHOOK_SECRET=

# Fernet key for encrypting stored GitHub user tokens.
TOKEN_ENCRYPTION_KEY=

# Answer generation (paid-tier key from a billing-enabled project)
GEMINI_API_KEY=
ANSWER_MODEL=gemini-3.8-flash
ANSWER_THINKING_LEVEL=medium

# Documentation embeddings
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-4

DAILY_QUESTION_LIMIT=20

# Fake provider behavior in fake mode: ok, unavailable, insufficient, invalid_citations, refusal
FAKE_ANSWER_MODEL_MODE=ok
# Fake embedder behavior in fake mode: ok, unavailable
FAKE_EMBEDDER_MODE=ok

# Development values that keep local use and tests clear of the pilot's limits. The pilot uses the
# defaults: 60 requests per minute per address on /auth and /webhooks, and 30 questions and 15
# reviews per day across all users. 0 turns rate limiting off.
RATE_LIMIT_PER_MINUTE=0
PILOT_DAILY_QUESTION_LIMIT=1000
PILOT_DAILY_REVIEW_LIMIT=1000
