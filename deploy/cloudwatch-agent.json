{
  "agent": {
    "metrics_collection_interval": 60
  },
  "metrics": {
    "namespace": "CWAgent",
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}"
    },
    "metrics_collected": {
      "mem": {
        "measurement": ["mem_used_percent"],
        "metrics_collection_interval": 60
      },
      "disk": {
        "measurement": ["used_percent"],
        "resources": ["/", "/var/lib/codeatlas"],
        "drop_device": true,
        "metrics_collection_interval": 60
      }
    }
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/codeatlas/*.log",
            "publish_multi_logs": true,
            "log_group_name": "/codeatlas/__ENVIRONMENT__/host",
            "log_stream_name": "{instance_id}"
          }
        ]
      }
    }
  }
}
