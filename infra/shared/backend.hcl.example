# Copy to backend.hcl (ignored by Git) and fill in, then:
#   terraform -chdir=infra/shared init -backend-config=backend.hcl
# The state bucket is created once with the AWS CLI (docs/operations.md, "The state bucket").
bucket  = "codeatlas-tfstate-<account ID>"
key     = "shared.tfstate"
region  = "us-east-1"
encrypt = true
